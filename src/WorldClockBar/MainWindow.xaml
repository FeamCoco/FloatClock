<Window x:Class="WorldClockBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WorldClockBar"
        WindowStyle="None"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="True"
        Visibility="Visible"
        SizeToContent="Manual"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseDoubleClick="OnMouseDoubleClick"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <!-- GlassFrameThickness=-1 extends the DWM frame over the whole window so the
         system acrylic backdrop can render. CaptionHeight must stay 0 — a caption
         would turn the whole bar into a system-draggable area. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="-1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <!-- 品牌规格 §5.2 没有时钟条边框这一项（§1 也禁用多余装饰），所以不再画 1px 描边。
         RootBorder 拉伸填满窗口：条宽是按占位串预算出来的（含取整余量），拉伸 + 内容居中
         能把这点余量均分到左右两侧，否则全堆在右边，看起来右边"边框"更宽。 -->
    <Border x:Name="RootBorder"
            CornerRadius="12"
            Padding="16,0"
            BorderThickness="0"
            Cursor="SizeAll">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="设置…" Click="OnOpenSettings">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="{StaticResource Fluent.IconFont}" Text="&#xE713;" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="选择显示器" x:Name="MonitorMenu">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="{StaticResource Fluent.IconFont}" Text="&#xE7F4;" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="开机自启" x:Name="AutoStartMenuItem" IsCheckable="True" Click="OnToggleAutoStart">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="{StaticResource Fluent.IconFont}" Text="&#xE7E8;" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="始终置顶" x:Name="TopmostMenuItem" IsCheckable="True" IsChecked="True" Click="OnToggleTopmost">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="{StaticResource Fluent.IconFont}" Text="&#xE718;" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="贴回右下角" Click="OnReposition">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="{StaticResource Fluent.IconFont}" Text="&#xE72C;" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="退出" Click="OnExit">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="{StaticResource Fluent.IconFont}" Text="&#xE711;" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Border.ContextMenu>
        <ItemsControl x:Name="ClocksPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Border>
</Window>
