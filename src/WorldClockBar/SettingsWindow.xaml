<Window x:Class="WorldClockBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WorldClockBar 设置"
        Height="640" Width="780"
        MinHeight="560" MinWidth="690"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        SourceInitialized="OnSourceInitialized">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SettingsRow" TargetType="Border">
            <Setter Property="Margin" Value="16,0"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Fluent.Divider}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
        <Style x:Key="RowContent" TargetType="Grid">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowDescText" TargetType="TextBlock" BasedOn="{StaticResource FluentRowDesc}">
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="ControlCol" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ title bar ============ -->
        <Grid Background="Transparent">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <!-- 窗口身份 = 应用图标：品牌青圆角方块（圆角 = 边长 × 22%）+ 子午盘标志 -->
                <Border Style="{StaticResource Brand.Tile}" Width="16" Height="16" VerticalAlignment="Center">
                    <Path Width="9.5" Height="9.5" Stretch="Uniform"
                          Fill="{DynamicResource Fluent.AccentText}"
                          Data="{StaticResource Brand.MarkGeometry}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="WorldClockBar 设置" FontSize="12.5" Margin="10,0,0,0"
                           Foreground="{DynamicResource Fluent.TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinButton" Style="{StaticResource FluentTitleBarButton}" Click="OnMinimize">
                    <TextBlock Text="&#xE921;" FontFamily="{StaticResource Fluent.IconFont}" FontSize="10"/>
                </Button>
                <Button x:Name="MaxButton" Style="{StaticResource FluentTitleBarButton}" Click="OnMaximize">
                    <TextBlock Text="&#xE922;" FontFamily="{StaticResource Fluent.IconFont}" FontSize="10"/>
                </Button>
                <Button Style="{StaticResource FluentTitleBarCloseButton}" Click="OnCloseWindow">
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource Fluent.IconFont}" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ body ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- navigation -->
            <Border Margin="8,0,0,8" CornerRadius="0" Background="{DynamicResource Fluent.NavBg}">
                <Grid Margin="8,4,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- §6.1 导航顶部的品牌身份：22px 标志 + 文字标。这是窗口与图标同源的地方。 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="13,4,0,14"
                                VerticalAlignment="Center">
                        <Path Width="22" Height="22" Stretch="Uniform"
                              Fill="{DynamicResource Fluent.Accent}"
                              Data="{StaticResource Brand.MarkGeometry}"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="WorldClockBar" FontSize="13.5" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Fluent.TextPrimary}"/>
                    </StackPanel>

                    <Grid x:Name="SearchHost" Grid.Row="1">
                        <TextBox x:Name="SearchBox" FontSize="13" Padding="28,6,9,6"
                                 TextChanged="OnSearchTextChanged"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Fluent.IconFont}" FontSize="13"
                                   Margin="10,0,0,0" Foreground="{DynamicResource Fluent.TextTertiary}"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="搜索设置…" FontSize="13" Margin="30,0,0,0"
                                   Foreground="{DynamicResource Fluent.TextTertiary}"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Border x:Name="SearchResultsHost" Visibility="Collapsed" Margin="0,36,0,0">
                            <ListBox x:Name="SearchResults"
                                     Background="{DynamicResource Fluent.SurfaceSolid}"
                                     BorderBrush="{DynamicResource Fluent.CardBorder}" BorderThickness="1"
                                     Padding="4"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="OnSearchResultSelected">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="9,6"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Fluent.TextPrimary}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                                            Background="Transparent">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fluent.RowHover}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fluent.RowSelected}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <RadioButton x:Name="NavClocks" Style="{StaticResource FluentNavItem}" GroupName="Nav"
                                     Tag="&#xE823;" Content="时钟" IsChecked="True" Checked="OnNavChanged"/>
                        <RadioButton x:Name="NavLook" Style="{StaticResource FluentNavItem}" GroupName="Nav"
                                     Tag="&#xE771;" Content="个性化" Checked="OnNavChanged"/>
                        <RadioButton x:Name="NavBehavior" Style="{StaticResource FluentNavItem}" GroupName="Nav"
                                     Tag="&#xE713;" Content="行为" Checked="OnNavChanged"/>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource FluentNavItem}" GroupName="Nav"
                                     Tag="&#xE946;" Content="关于" Checked="OnNavChanged"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" x:Name="VersionText" FontSize="11"
                               Foreground="{DynamicResource Fluent.TextTertiary}" Margin="13,0,0,0"/>
                </Grid>
            </Border>

            <!-- content pages -->
            <Grid Grid.Column="1" Margin="10,0,0,0">

                <!-- ================= 时钟 ================= -->
                <ScrollViewer x:Name="PageClocks" VerticalScrollBarVisibility="Auto"
                              Padding="0,0,8,0">
                    <StackPanel Margin="4,6,18,26">
                        <TextBlock Text="时钟" Style="{StaticResource FluentPageTitle}" Margin="0,8,0,4"/>
                        <TextBlock Text="管理时钟条显示的城市与时间格式，改动即时生效。" Style="{StaticResource FluentPageSub}"/>

                        <!-- 城市列表 -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,20,0,0">
                            <StackPanel>
                                <Grid Margin="16,0" Height="46">
                                    <TextBlock Text="城市" Style="{StaticResource FluentRowTitle}" VerticalAlignment="Center"/>
                                    <TextBlock Text="长按拖动排序 · 或用 ⋮ 菜单" FontSize="12"
                                               Foreground="{DynamicResource Fluent.TextTertiary}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl x:Name="CityList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SettingsRow}">
                                                <Grid Style="{StaticResource RowContent}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="168"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE774;" Style="{StaticResource FluentRowIcon}"/>
                                                    <TextBox Grid.Column="1" Style="{StaticResource FluentInlineEdit}"
                                                             Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="显示名称，点击可直接编辑"/>
                                                    <ComboBox Grid.Column="2"
                                                              ItemsSource="{Binding DataContext.TimeZones, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedValue="{Binding TimeZoneId}"
                                                              SelectedValuePath="Id"
                                                              DisplayMemberPath="DisplayName"
                                                              HorizontalAlignment="Right"
                                                              MinWidth="150" MaxWidth="300"
                                                              Margin="12,0,8,0"
                                                              ToolTip="时区（含夏令时自动换算）"/>
                                                    <Button Grid.Column="3" Style="{StaticResource FluentSubtleButton}"
                                                            Padding="6,4" Click="OnRowMenu"
                                                            ToolTip="上移 / 下移 / 删除">
                                                        <TextBlock Text="&#xE712;" FontFamily="{StaticResource Fluent.IconFont}"
                                                                   FontSize="14"
                                                                   Foreground="{DynamicResource Fluent.TextSecondary}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="＋ 添加城市" Style="{StaticResource FluentLinkButton}"
                                        HorizontalAlignment="Left" Margin="16,10,0,12" Click="OnAddCity"/>
                            </StackPanel>
                        </Border>

                        <!-- 时间显示 -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,16,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                                    <Grid Style="{StaticResource RowContent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE823;" Style="{StaticResource FluentRowIcon}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="显示秒" Style="{StaticResource FluentRowTitle}"/>
                                            <TextBlock Text="关闭后只显示 时:分" Style="{StaticResource RowDescText}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" x:Name="ShowSecondsSwitch"
                                                  Checked="OnShowSecondsChanged" Unchecked="OnShowSecondsChanged"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid Style="{StaticResource RowContent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE8D2;" Style="{StaticResource FluentRowIcon}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="时间格式" Style="{StaticResource FluentRowTitle}"/>
                                            <TextBlock Text="12 / 24 小时制" Style="{StaticResource RowDescText}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" x:Name="HourFormatBox"
                                                  HorizontalAlignment="Right" MinWidth="120" MaxWidth="180"
                                                  SelectionChanged="OnHourFormatChanged">
                                            <ComboBoxItem Content="24 小时制" Tag="24"/>
                                            <ComboBoxItem Content="12 小时制" Tag="12"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 位置与显示器 -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,16,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                                    <Grid Style="{StaticResource RowContent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE76C;" Style="{StaticResource FluentRowIcon}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="贴边对齐" Style="{StaticResource FluentRowTitle}"/>
                                            <TextBlock Text="未拖拽时的默认停靠位置" Style="{StaticResource RowDescText}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" x:Name="AlignBox"
                                                  HorizontalAlignment="Right" MinWidth="150" MaxWidth="230"
                                                  SelectionChanged="OnAlignChanged">
                                            <ComboBoxItem Content="右下角 · 靠近系统时钟" Tag="Right"/>
                                            <ComboBoxItem Content="底部居中" Tag="Center"/>
                                            <ComboBoxItem Content="左下角" Tag="Left"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid Style="{StaticResource RowContent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7F4;" Style="{StaticResource FluentRowIcon}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="位置状态" Style="{StaticResource FluentRowTitle}"/>
                                            <TextBlock x:Name="PositionStateText" Style="{StaticResource RowDescText}"
                                                       Text="已贴边"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="贴回右下角" Style="{StaticResource FluentSubtleButton}"
                                                Padding="12,5" Click="OnRepositionClicked"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid Style="{StaticResource RowContent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7F8;" Style="{StaticResource FluentRowIcon}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="显示器" Style="{StaticResource FluentRowTitle}"/>
                                            <TextBlock Text="时钟条所在的屏幕，可跨屏拖拽" Style="{StaticResource RowDescText}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" x:Name="MonitorBox"
                                                  HorizontalAlignment="Right" MinWidth="150" MaxWidth="250"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectionChanged="OnMonitorChanged"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="2,12,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Fluent.TextTertiary}"
                                   Text="时钟条可在任务栏以外的工作区任意拖拽，靠近屏幕四边自动吸附；改动会自动保存。"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= 个性化 ================= -->
                <ScrollViewer x:Name="PageLook" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              Padding="0,0,8,0">
                    <StackPanel Margin="4,6,18,26">
                        <TextBlock Text="个性化" Style="{StaticResource FluentPageTitle}" Margin="0,8,0,4"/>
                        <TextBlock Text="选择主题预设，或微调颜色、字体与尺寸。" Style="{StaticResource FluentPageSub}"/>

                        <!-- 主题预设 -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,20,0,0">
                            <StackPanel>
                                <Grid Margin="16,0" Height="46">
                                    <TextBlock Text="主题预设" Style="{StaticResource FluentRowTitle}" VerticalAlignment="Center"/>
                                    <TextBlock Text="点击即换 · 跟随系统可随深浅色自动切换" FontSize="12"
                                               Foreground="{DynamicResource Fluent.TextTertiary}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- 品牌规格 §7：由 7 套收敛为 4 套（跟随系统 + 品牌浅 / 品牌深 + 高对比）。
                                     每张卡是一小段真实时钟条预览：品牌青圆点 + tabular 时分。 -->
                                <WrapPanel Margin="16,4,16,16">
                                    <Button Style="{StaticResource FluentSubtleButton}" Click="OnThemePreset" Tag="System"
                                            Padding="4" Margin="0,0,10,10" Width="122" Cursor="Hand">
                                        <StackPanel>
                                            <Border x:Name="ThemeBd_System" CornerRadius="4" BorderThickness="2" BorderBrush="Transparent">
                                                <Border CornerRadius="3" Height="36" Width="112" BorderThickness="1" BorderBrush="#FFE2E8E8">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#FFFFFFFF" Offset="0.62"/>
                                                            <GradientStop Color="#FF111817" Offset="0.62"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                                                VerticalAlignment="Center" Margin="9,0,0,0">
                                                        <Ellipse Width="5" Height="5" Margin="0,0,5,0"
                                                                 Fill="{DynamicResource Fluent.Accent}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="20:15" FontFamily="{StaticResource Fluent.DisplayFont}"
                                                                   FontWeight="SemiBold" FontSize="14" Foreground="#FF14201E"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                            <TextBlock Text="跟随系统" FontSize="12" Margin="0,6,0,2" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Fluent.TextSecondary}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource FluentSubtleButton}" Click="OnThemePreset" Tag="Light"
                                            Padding="4" Margin="0,0,10,10" Width="122" Cursor="Hand">
                                        <StackPanel>
                                            <Border x:Name="ThemeBd_Light" CornerRadius="4" BorderThickness="2" BorderBrush="Transparent">
                                                <Border CornerRadius="3" Height="36" Width="112" Background="#FFFFFFFF"
                                                        BorderThickness="1" BorderBrush="#FFE2E8E8">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                                                VerticalAlignment="Center" Margin="9,0,0,0">
                                                        <Ellipse Width="5" Height="5" Margin="0,0,5,0"
                                                                 Fill="{DynamicResource Fluent.Accent}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="20:15" FontFamily="{StaticResource Fluent.DisplayFont}"
                                                                   FontWeight="SemiBold" FontSize="14" Foreground="#FF14201E"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                            <TextBlock Text="品牌浅色" FontSize="12" Margin="0,6,0,2" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Fluent.TextSecondary}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource FluentSubtleButton}" Click="OnThemePreset" Tag="Dark"
                                            Padding="4" Margin="0,0,10,10" Width="122" Cursor="Hand">
                                        <StackPanel>
                                            <Border x:Name="ThemeBd_Dark" CornerRadius="4" BorderThickness="2" BorderBrush="Transparent">
                                                <Border CornerRadius="3" Height="36" Width="112" Background="#FF111817">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                                                VerticalAlignment="Center" Margin="9,0,0,0">
                                                        <Ellipse Width="5" Height="5" Margin="0,0,5,0"
                                                                 Fill="{DynamicResource Fluent.Accent}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="20:15" FontFamily="{StaticResource Fluent.DisplayFont}"
                                                                   FontWeight="SemiBold" FontSize="14" Foreground="#FFEAF3F1"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                            <TextBlock Text="品牌深色" FontSize="12" Margin="0,6,0,2" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Fluent.TextSecondary}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource FluentSubtleButton}" Click="OnThemePreset" Tag="HighContrast"
                                            Padding="4" Margin="0,0,10,10" Width="122" Cursor="Hand">
                                        <StackPanel>
                                            <Border x:Name="ThemeBd_HighContrast" CornerRadius="4" BorderThickness="2" BorderBrush="Transparent">
                                                <Border CornerRadius="3" Height="36" Width="112" Background="#FF000000">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                                                VerticalAlignment="Center" Margin="9,0,0,0">
                                                        <Ellipse Width="5" Height="5" Margin="0,0,5,0"
                                                                 Fill="#FFFFE000" VerticalAlignment="Center"/>
                                                        <TextBlock Text="20:15" FontFamily="{StaticResource Fluent.DisplayFont}"
                                                                   FontWeight="SemiBold" FontSize="14" Foreground="#FFFFE000"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                            <TextBlock Text="高对比" FontSize="12" Margin="0,6,0,2" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Fluent.TextSecondary}"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 颜色 -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid Margin="16,0" Height="46">
                                    <TextBlock Text="颜色" Style="{StaticResource FluentRowTitle}" VerticalAlignment="Center"/>
                                    <TextBlock Text="手动修改后不再跟随主题预设" FontSize="12"
                                               Foreground="{DynamicResource Fluent.TextTertiary}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                                    <Grid Style="{StaticResource RowContent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE790;" Style="{StaticResource FluentRowIcon}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="背景色" Style="{StaticResource FluentRowTitle}"/>
                                            <TextBlock Text="支持透明度（ARGB）" Style="{StaticResource RowDescText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Style="{StaticResource ControlCol}">
                                            <Button Style="{StaticResource FluentSubtleButton}" Padding="2" Click="OnPickBackground">
                                                <Border x:Name="BgSwatch" Width="44" Height="24" CornerRadius="4"
                                                        BorderBrush="{DynamicResource Fluent.ControlBorder}" BorderThickness="1"/>
                                            </Button>
                                            <TextBox x:Name="BgColorBox" Width="112" Margin="10,0,0,0" FontSize="12.5"
                                                     TextChanged="OnColorTextChanged"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid Style="{StaticResource RowContent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE790;" Style="{StaticResource FluentRowIcon}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="文字色" Style="{StaticResource FluentRowTitle}"/>
                                            <TextBlock Text="时间与城市名" Style="{StaticResource RowDescText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Style="{StaticResource ControlCol}">
                                            <Button Style="{StaticResource FluentSubtleButton}" Padding="2" Click="OnPickForeground">
                                                <Border x:Name="FgSwatch" Width="44" Height="24" CornerRadius="4"
                                                        BorderBrush="{DynamicResource Fluent.ControlBorder}" BorderThickness="1"/>
                                            </Button>
                                            <TextBox x:Name="FgColorBox" Width="112" Margin="10,0,0,0" FontSize="12.5"
                                                     TextChanged="OnColorTextChanged"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- 分隔符色一行已随 §5.1 去掉：城市之间不再有竖线，改由 26px 留白划分，
                                     留一个改了没反应的取色器比少一个控件更糟。 -->
                            </StackPanel>
                        </Border>

                        <!-- 字体与尺寸 -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,16,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                                    <Grid Style="{StaticResource RowContent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE8D2;" Style="{StaticResource FluentRowIcon}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="字体" Style="{StaticResource FluentRowTitle}"/>
                                            <TextBlock Text="推荐 Segoe UI Variable Display" Style="{StaticResource RowDescText}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" x:Name="FontFamilyBox" Width="240"
                                                  SelectionChanged="OnFontChanged"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid Style="{StaticResource RowContent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE8D2;" Style="{StaticResource FluentRowIcon}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="字号" Style="{StaticResource FluentRowTitle}"/>
                                            <TextBlock Text="时分字号，默认 19" Style="{StaticResource RowDescText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Style="{StaticResource ControlCol}" Width="240">
                                            <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="32" IsSnapToTickEnabled="True"
                                                    TickFrequency="1" Width="196" ValueChanged="OnSizeSliderChanged"/>
                                            <TextBlock x:Name="FontSizeValue" Width="32" Margin="12,0,0,0"
                                                       TextAlignment="Center" Style="{StaticResource FluentRowTitle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid Style="{StaticResource RowContent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7EB;" Style="{StaticResource FluentRowIcon}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="条高" Style="{StaticResource FluentRowTitle}"/>
                                            <TextBlock Text="成组两行结构，默认 60；下限随字号推导" Style="{StaticResource RowDescText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Style="{StaticResource ControlCol}" Width="240">
                                            <Slider x:Name="HeightSlider" Minimum="52" Maximum="96" IsSnapToTickEnabled="True"
                                                    TickFrequency="1" Width="196" ValueChanged="OnSizeSliderChanged"/>
                                            <TextBlock x:Name="HeightValue" Width="32" Margin="12,0,0,0"
                                                       TextAlignment="Center" Style="{StaticResource FluentRowTitle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid Style="{StaticResource RowContent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7EB;" Style="{StaticResource FluentRowIcon}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="圆角" Style="{StaticResource FluentRowTitle}"/>
                                            <TextBlock Text="0 为直角，默认 12" Style="{StaticResource RowDescText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Style="{StaticResource ControlCol}" Width="240">
                                            <Slider x:Name="RadiusSlider" Minimum="0" Maximum="20" IsSnapToTickEnabled="True"
                                                    TickFrequency="1" Width="196" ValueChanged="OnSizeSliderChanged"/>
                                            <TextBlock x:Name="RadiusValue" Width="32" Margin="12,0,0,0"
                                                       TextAlignment="Center" Style="{StaticResource FluentRowTitle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid Style="{StaticResource RowContent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7B3;" Style="{StaticResource FluentRowIcon}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="透明度" Style="{StaticResource FluentRowTitle}"/>
                                            <TextBlock Text="配合亚克力材质更通透" Style="{StaticResource RowDescText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Style="{StaticResource ControlCol}" Width="240">
                                            <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1.0" Width="196"
                                                    ValueChanged="OnSizeSliderChanged"/>
                                            <TextBlock x:Name="OpacityValue" Width="36" Margin="8,0,0,0"
                                                       TextAlignment="Center" Style="{StaticResource FluentRowTitle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= 行为 ================= -->
                <ScrollViewer x:Name="PageBehavior" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              Padding="0,0,8,0">
                    <StackPanel Margin="4,6,18,26">
                        <TextBlock Text="行为" Style="{StaticResource FluentPageTitle}" Margin="0,8,0,4"/>
                        <TextBlock Text="启动与显示行为。" Style="{StaticResource FluentPageSub}"/>

                        <Border Style="{StaticResource FluentCard}" Margin="0,20,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                                    <Grid Style="{StaticResource RowContent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7E8;" Style="{StaticResource FluentRowIcon}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="开机自动启动" Style="{StaticResource FluentRowTitle}"/>
                                            <TextBlock Text="写入当前用户的启动项（注册表 Run）" Style="{StaticResource RowDescText}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" x:Name="AutoStartSwitch"
                                                  Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid Style="{StaticResource RowContent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE718;" Style="{StaticResource FluentRowIcon}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="始终置顶" Style="{StaticResource FluentRowTitle}"/>
                                            <TextBlock Text="始终开启，每秒自动巩固 Z 序（全屏独占游戏除外）" Style="{StaticResource RowDescText}"/>
                                        </StackPanel>
                                        <!-- 状态标签，不是开关：后台每秒都会强制置顶（SettingsWindow.OnToggleTopmost /
                                             MainWindow.EnforceTopmost 都写死 true），做成胶囊会被当成开关去点。
                                             描边 + 锁形图标，明确表达"这是说明，不可切换"。 -->
                                        <Border Grid.Column="2" CornerRadius="4" Padding="8,4"
                                                BorderBrush="{DynamicResource Fluent.ControlBorder}"
                                                BorderThickness="1" Background="Transparent"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Fluent.IconFont}"
                                                           FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Fluent.TextTertiary}"/>
                                                <TextBlock Text="始终开启" FontSize="11.5" Margin="5,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Fluent.TextTertiary}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FluentCard}" Margin="0,16,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                                    <Grid Style="{StaticResource RowContent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE946;" Style="{StaticResource FluentRowIcon}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="不访问网络" Style="{StaticResource FluentRowTitle}"/>
                                            <TextBlock Text="所有时间按本机系统时钟 + TimeZoneInfo 换算" Style="{StaticResource RowDescText}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid Style="{StaticResource RowContent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE946;" Style="{StaticResource FluentRowIcon}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="不注入系统任务栏" Style="{StaticResource FluentRowTitle}"/>
                                            <TextBlock Text="独立置顶窗口贴在任务栏上方，与常见任务栏插件冲突风险低" Style="{StaticResource RowDescText}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= 关于 ================= -->
                <ScrollViewer x:Name="PageAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              Padding="0,0,8,0">
                    <StackPanel Margin="4,6,18,26">
                        <TextBlock Text="关于" Style="{StaticResource FluentPageTitle}" Margin="0,8,0,4"/>
                        <TextBlock Text="WorldClockBar — 任务栏上方的多时区时钟条。" Style="{StaticResource FluentPageSub}"/>

                        <Border Style="{StaticResource FluentCard}" Margin="0,20,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                                    <Grid Style="{StaticResource RowContent}" Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource Fluent.Accent}">
                                            <TextBlock Text="&#xE823;" FontFamily="{StaticResource Fluent.IconFont}" FontSize="20"
                                                       Foreground="{DynamicResource Fluent.AccentText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <TextBlock Text="WorldClockBar" Style="{StaticResource FluentRowTitle}" FontSize="16"/>
                                            <TextBlock x:Name="AboutVersion" FontSize="12" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource Fluent.TextSecondary}"/>
                                            <TextBlock FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Fluent.TextSecondary}"
                                                       Text="MIT 许可证 · 本地换算，不联网，不注入任务栏。"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid Style="{StaticResource RowContent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE8A5;" Style="{StaticResource FluentRowIcon}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="项目主页" Style="{StaticResource FluentRowTitle}"/>
                                            <TextBlock Text="github.com/FeamCoco/FloatClock" Style="{StaticResource RowDescText}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="打开" Style="{StaticResource FluentSubtleButton}"
                                                Padding="14,5" Click="OnOpenHomepage"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid Style="{StaticResource RowContent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource FluentRowIcon}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="配置文件" Style="{StaticResource FluentRowTitle}"/>
                                            <TextBlock x:Name="ConfigPathText" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource Fluent.TextTertiary}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="打开文件夹" Style="{StaticResource FluentSubtleButton}"
                                                Padding="14,5" Click="OnOpenConfigFolder"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid Style="{StaticResource RowContent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource FluentRowIcon}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="重置为默认配置" Style="{StaticResource FluentRowTitle}"/>
                                            <TextBlock Text="恢复默认城市、主题与位置" Style="{StaticResource RowDescText}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="重置" Style="{StaticResource FluentSubtleButton}"
                                                Padding="14,5" Click="OnResetDefaults"
                                                Foreground="{DynamicResource Fluent.Error}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- transient save-status pill -->
        <Border x:Name="StatusPill" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,22,16" CornerRadius="99" Padding="13,6"
                Background="{DynamicResource Fluent.SurfaceSolid}"
                BorderBrush="{DynamicResource Fluent.CardBorder}" BorderThickness="1"
                Effect="{StaticResource Fluent.TooltipShadow}" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource Fluent.TextSecondary}"/>
        </Border>
    </Grid>
</Window>
