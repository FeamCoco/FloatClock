<Application x:Class="WorldClockBar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="SettingsBg" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="SettingsCard" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SettingsBorder" Color="#E0E0E5"/>
        <SolidColorBrush x:Key="SettingsAccent" Color="#0078D4"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Application.Resources>
</Application>
